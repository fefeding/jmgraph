{
  "family": "jmgraph",
  "name": "jmgraph",
  "version": "3.3.0",
  "description": "一个简单的canvas画图库",
  "homepage": "https://surl.fit/tools/tools/jmgraph",
  "keywords": [
    "canvas",
    "html5",
    "webgl"
  ],
  "author": "jiamao<haofefe@163.com>",
  "engines": {},
  "devDependencies": {
    "@commitlint/cli": "^7.6.1",
    "@commitlint/config-conventional": "^7.6.0",
    "canvas": "^2.11.2",
    "cz-conventional-changelog": "^2.1.0",
    "express": "^4.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fefeding/jmgraph.git"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./components": {
      "types": "./src/components/index.d.ts",
      "import": "./src/components/index.js",
      "default": "./src/components/index.js"
    },
    "./src/components": {
      "types": "./src/components/index.d.ts",
      "import": "./src/components/index.js",
      "default": "./src/components/index.js"
    },
    "./src/*": "./src/*"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/fefeding/jmgraph/blob/master/LICENSE"
    }
  ],
  "bugs": {
    "url": "https://github.com/fefeding/jmgraph/issues"
  },
  "directories": {
    "example": "example"
  },
  "scripts": {
    "build": "cd build && npm i --legacy-peer-deps && npx gulp && cd ..",
    "push": "npm publish --registry=https://registry.npmjs.org",
    "dev": "node dev",
    "test": "node --test test/*.test.mjs",
    "test:watch": "node --test --watch test/*.test.mjs",
    "check": "node --check index.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
